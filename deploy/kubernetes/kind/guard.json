{
  "permission": "protected-groups",
  "groups": ["/squared-admins"],
  "tenantGroupPrefix": "tenant-",
  "projectPrefix": "",
  "sources": [
    {"type": "argocd-rbac", "service": "Argo CD", "namespace": "argocd", "name": "argocd-rbac-cm"},
    {"type": "argocd-projects", "service": "Argo CD", "namespace": "argocd",
     "repoPrefixes": ["http://forgejo.localhost:30300/squared/"], "clusterServers": ["https://kubernetes.default.svc"]},
    {"type": "argocd-applications", "service": "Argo CD", "namespace": "argocd", "name": "squared-platform",
     "rootSource": {"repoURL": "http://forgejo.localhost:30300/squared/platform.git", "targetRevision": "main", "path": "tenants"},
     "controllerBindRoles": ["squared-worker-pull-secrets"],
     "serverWebhook": "http://argocd-server.argocd.svc.cluster.local/api/webhook",
     "repoPrefixes": ["http://forgejo.localhost:30300/squared/"], "clusterServers": ["https://kubernetes.default.svc"]},
    {"type": "argocd-repositories", "service": "Argo CD", "url": "http://argocd-server.argocd.svc.cluster.local",
     "passwordFile": "/etc/squared/secrets/argocd-token", "repoPrefixes": ["http://forgejo.localhost:30300/squared/"]},
    {"type": "argocd-clusters", "service": "Argo CD", "url": "http://argocd-server.argocd.svc.cluster.local",
     "passwordFile": "/etc/squared/secrets/argocd-token", "clusterServers": ["https://kubernetes.default.svc"]},
    {"type": "harbor-members", "service": "Harbor", "url": "http://harbor.harbor.svc.cluster.local",
     "user": "robot$squared-guard", "passwordFile": "/etc/squared/secrets/harbor-robot-password"},
    {"type": "harbor-database", "service": "Harbor",
     "url": "postgres://squared_guard@harbor-database.harbor.svc.cluster.local:5432/registry?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/harbor-db-password"},
    {"type": "keycloak-mappers", "service": "Keycloak",
     "clients": ["squared", "squared-cli", "argocd", "harbor", "forgejo"], "audiences": ["squared-api"]},
    {"type": "keycloak-realm", "service": "Keycloak"},
    {"type": "forgejo-credentials", "service": "Forgejo", "sourceId": 1,
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-deploy-keys", "service": "Forgejo", "org": "squared",
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-writers", "service": "Forgejo", "org": "squared", "writers": ["squared-bot"],
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-branches", "service": "Forgejo", "org": "squared", "writers": ["squared-bot"],
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-webhooks", "service": "Forgejo", "org": "squared",
     "webhooks": ["http://argocd-server.argocd.svc.cluster.local/api/webhook"],
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-mirrors", "service": "Forgejo", "org": "squared",
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-config", "service": "Forgejo", "url": "http://forgejo-config.forgejo.svc.cluster.local:8083/settings",
     "webhookHosts": ["argocd-server.argocd.svc.cluster.local"]},
    {"type": "configmap", "service": "Squared", "namespace": "squared", "selector": "squared.dev/config=true", "key": "SQUARED_OIDC_ADMIN_GROUP"},
    {"type": "forgejo-database", "service": "Forgejo",
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"}
  ]
}
