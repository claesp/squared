{
  "permission": "protected-groups",
  "groups": ["/squared-admins"],
  "tenantGroupPrefix": "tenant-",
  "projectPrefix": "",
  "sources": [
    {"type": "argocd-rbac", "service": "Argo CD", "namespace": "argocd", "name": "argocd-rbac-cm"},
    {"type": "argocd-projects", "service": "Argo CD", "namespace": "argocd"},
    {"type": "harbor-members", "service": "Harbor", "url": "http://harbor.harbor.svc.cluster.local",
     "user": "robot$squared-guard", "passwordFile": "/etc/squared/secrets/harbor-robot-password"},
    {"type": "harbor-database", "service": "Harbor",
     "url": "postgres://squared_guard@harbor-database.harbor.svc.cluster.local:5432/registry?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/harbor-db-password"},
    {"type": "keycloak-mappers", "service": "Keycloak",
     "clients": ["squared", "squared-cli", "argocd", "harbor", "forgejo"], "audiences": ["squared-api"]},
    {"type": "keycloak-realm", "service": "Keycloak"},
    {"type": "forgejo-credentials", "service": "Forgejo", "sourceId": 1,
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-deploy-keys", "service": "Forgejo", "org": "squared",
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-writers", "service": "Forgejo", "org": "squared", "writers": ["squared-bot"],
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"},
    {"type": "forgejo-config", "service": "Forgejo", "url": "http://forgejo-config.forgejo.svc.cluster.local:8083/sign-in"},
    {"type": "configmap", "service": "Squared", "namespace": "squared", "selector": "squared.dev/config=true", "key": "SQUARED_OIDC_ADMIN_GROUP"},
    {"type": "forgejo-database", "service": "Forgejo",
     "url": "postgres://squared_guard@forgejo-db.forgejo.svc.cluster.local:5432/forgejo?sslmode=disable",
     "passwordFile": "/etc/squared/secrets/forgejo-db-password"}
  ]
}
