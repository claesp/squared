# cronjob-shop-job.json
{
  "apiVersion": "batch/v1",
  "kind": "CronJob",
  "metadata": {
    "name": "shop-job",
    "namespace": "acme-dev",
    "labels": {
      "app.kubernetes.io/component": "job",
      "app.kubernetes.io/instance": "shop",
      "app.kubernetes.io/managed-by": "squared",
      "app.kubernetes.io/name": "job",
      "app.kubernetes.io/part-of": "scheduled-job",
      "app.kubernetes.io/version": "1.0.0",
      "squared.dev/deployment": "shop",
      "squared.dev/tenant": "acme"
    }
  },
  "spec": {
    "schedule": "0 3 * * *",
    "timeZone": "Etc/UTC",
    "concurrencyPolicy": "Forbid",
    "successfulJobsHistoryLimit": 3,
    "failedJobsHistoryLimit": 3,
    "jobTemplate": {
      "spec": {
        "backoffLimit": 2,
        "activeDeadlineSeconds": 3600,
        "ttlSecondsAfterFinished": 86400,
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/component": "job",
              "app.kubernetes.io/instance": "shop",
              "app.kubernetes.io/managed-by": "squared",
              "app.kubernetes.io/name": "job",
              "app.kubernetes.io/part-of": "scheduled-job",
              "app.kubernetes.io/version": "1.0.0",
              "squared.dev/deployment": "shop",
              "squared.dev/tenant": "acme"
            }
          },
          "spec": {
            "serviceAccountName": "shop-job",
            "automountServiceAccountToken": false,
            "enableServiceLinks": false,
            "restartPolicy": "Never",
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "imagePullSecrets": [
              {
                "name": "squared-registry"
              }
            ],
            "containers": [
              {
                "name": "job",
                "image": "registry.test/acme/app@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "imagePullPolicy": "IfNotPresent",
                "env": [
                  {
                    "name": "SQUARED_COMPONENT",
                    "value": "job"
                  },
                  {
                    "name": "SQUARED_DEPLOYMENT",
                    "value": "shop"
                  },
                  {
                    "name": "SQUARED_TENANT",
                    "value": "acme"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ]
          }
        }
      }
    }
  }
}
# serviceaccount-shop-job.json
{
  "apiVersion": "v1",
  "kind": "ServiceAccount",
  "metadata": {
    "name": "shop-job",
    "namespace": "acme-dev",
    "labels": {
      "app.kubernetes.io/component": "job",
      "app.kubernetes.io/instance": "shop",
      "app.kubernetes.io/managed-by": "squared",
      "app.kubernetes.io/name": "job",
      "app.kubernetes.io/part-of": "scheduled-job",
      "app.kubernetes.io/version": "1.0.0",
      "squared.dev/deployment": "shop",
      "squared.dev/tenant": "acme"
    }
  },
  "automountServiceAccountToken": false
}
